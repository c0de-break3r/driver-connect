{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/components/ui/*": [
        "./src/components/ui/*"
      ],
      "@driverconnect/shared-types": [
        "../../packages/shared-types"
      ],
      "@driverconnect/shared-types/*": [
        "../../packages/shared-types/*"
      ],
      "@driverconnect/shared-constants": [
        "../../packages/shared-constants"
      ],
      "@driverconnect/shared-constants/*": [
        "../../packages/shared-constants/*"
      ],
      "convex/_generated/*": [
        "../../convex/_generated/*"
      ],
      "convex/_generated/api": [
        "../../convex/_generated/api"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "src/components/ui"
  ]
}