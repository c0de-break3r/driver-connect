{
  "expo": {
    "name": "Driver Connect",
    "slug": "driver-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "driverconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.jpg",
        "backgroundImage": "./assets/images/android-icon-background.jpg",
        "monochromeImage": "./assets/images/android-icon-monochrome.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.c0debreak3r.driverconnect"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      [
        "@maplibre/maplibre-react-native",
        {
          "maplibreGLNativeVersion": "11.3.6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "386e3dce-e44a-415a-96f7-75e292c892a8"
      }
    },
    "owner": "c0de-break3r"
  }
}
